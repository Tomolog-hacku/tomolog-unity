# Unity向けの推奨 .gitignore
# 参考: https://github.com/github/gitignore/blob/main/Unity.gitignore

# --- OS / Editor 一般 ---
.DS_Store
Thumbs.db

# --- Unity 自動生成フォルダ ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
MemoryCaptures/
UserSettings/

# --- Visual Studio / Rider / VSCode ---
.vs/
.vscode/
.idea/
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.csproj
*.unityproj
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# --- ビルド生成物 / キャッシュ ---
*.apk
*.aab
*.unitypackage

# Autogenerated by JetBrains Rider
/.idea/

# --- その他 ---
# ビルド設定やエディタ固有の一時ファイル
BuildPlayer.prefs

# Keep the following (important project files)
# - Assets/
# - ProjectSettings/
# - Packages/

# ローカルのSecretsや個人設定、IDE固有の設定を無視する追加ルール
*.log
*.log.*

# End of .gitignore

